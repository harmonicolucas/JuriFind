# Copie para .env e preencha apenas no servidor. Nunca publique este ficheiro com segredos.

# Porta do servidor local e do contentor.
PORT=8787

# API pública de leitura do directório de origem (WordPress REST).
SOURCE_API_BASE=https://encontreadvogados.co.mz/wp-json/wp/v2

# Cache local do índice factual (nome, áreas, localização, línguas e ligação).
# Não contém biografias nem fotografias. A pasta data/cache/ não entra no Git.
CACHE_FILE=data/cache/index.json
CACHE_TTL_HOURS=6

# Modelo de linguagem, opcional. Sem chave, o JuriFind usa regras locais.
# Compatível com a API de chat da OpenAI (OpenAI, Azure com URL compatível, etc.).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Origem permitida no browser quando o frontend está noutro domínio (GitHub Pages).
# Exemplo: https://harmonicolucas.github.io
# Vazio = apenas o mesmo servidor (recomendado em desenvolvimento).
ALLOWED_ORIGIN=

# Confiar em X-Forwarded-For. Active apenas atrás de um proxy que o defina.
TRUST_PROXY=false

# Pedidos de recomendação por endereço, em cada janela.
RATE_LIMIT=20
RATE_WINDOW_MS=600000

# Ler o telefone publicado no perfil original para os primeiros resultados.
# O número não é gravado em disco. false desliga esta leitura.
ENRICH_CONTACTS=true

# Slugs de perfis a omitir, separados por vírgulas. Ex.: algum-advogado,outro-nome
EXCLUDE_SLUGS=
